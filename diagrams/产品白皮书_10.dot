n6 [label="用户仍可回到原引用",shape=box,fillcolor="#EFF3E7"];
n0 -> n1 [label="",style=solid];
n1 -> n2 [label="",style=solid];
n1 -> n3 [label="",style=solid];
n1 -> n4 [label="",style=solid];
n1 -> n5 [label="",style=solid];
