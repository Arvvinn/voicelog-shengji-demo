n0 [label="原句被纠正",shape=box,fillcolor="#BDDF58"];
n1 [label="保存转写新版本",shape=box,fillcolor="#EFF3E7"];
n2 [label="原引用保留历史版本",shape=box,fillcolor="#EFF3E7"];
n3 [label="相关整理标为待更新",shape=box,fillcolor="#EFF3E7"];
