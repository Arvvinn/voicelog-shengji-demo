digraph G {
graph [rankdir=TB, bgcolor="transparent", pad="0.2", nodesep="0.27", ranksep="0.38", splines=polyline];
node [shape=box,style="rounded,filled",fillcolor="#EFF3E7",color="#CFDCC1",penwidth=1,fontname="Noto Sans CJK SC",fontsize=12,fontcolor="#203A2C",margin="0.14,0.11"];
edge [color="#8FA782",arrowsize=.55,penwidth=1.1,fontname="Noto Sans CJK SC",fontsize=9,fontcolor="#6A7F5F"];
n0 [label="",shape=circle,fillcolor="#BDDF58"];
n1 [label="局部预览",shape=box,fillcolor="#EFF3E7"];
n2 [label="完整画布",shape=box,fillcolor="#EFF3E7"];
n3 [label="节点选中",shape=box,fillcolor="#EFF3E7"];
