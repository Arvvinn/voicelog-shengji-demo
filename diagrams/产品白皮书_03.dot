digraph G {
graph [rankdir=LR, bgcolor="transparent", pad="0.2", nodesep="0.27", ranksep="0.38", splines=polyline];
node [shape=box,style="rounded,filled",fillcolor="#EFF3E7",color="#CFDCC1",penwidth=1,fontname="Noto Sans CJK SC",fontsize=12,fontcolor="#203A2C",margin="0.14,0.11"];
edge [color="#8FA782",arrowsize=.55,penwidth=1.1,fontname="Noto Sans CJK SC",fontsize=9,fontcolor="#6A7F5F"];
n0 [label="原话与当次上下文",shape=box,fillcolor="#BDDF58"];
n1 [label="生成有限候选解释",shape=box,fillcolor="#EFF3E7"];
n2 [label="判别层评估支持程度",shape=box,fillcolor="#EFF3E7"];
n3 [label="保留候选 · 另一种\n解释 · 依据不足",shape=box,fillcolor="#EFF3E7"];
n4 [label="本人选择或否定",shape=box,fillcolor="#EFF3E7"];
n5 [label="回复草稿与后续讨论",shape=box,fillcolor="#EFF3E7"];
n0 -> n1 [label="",style=solid];
n1 -> n2 [label="",style=solid];
n2 -> n3 [label="",style=solid];
n3 -> n4 [label="",style=solid];
n4 -> n5 [label="",style=solid];
}